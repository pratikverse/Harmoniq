# Python generated files
__pycache__/
*.pyc
*.pyd
dist/
build/
eggs/
.ipynb_checkpoints/

# Virtual environment
music_venv/
venv/
env/
.venv/

# Data and model files (large and generated)
data/preprocessed/
models/trained/
model_metrics.txt
training_history.png

# models/catalog.parquet, embedding.npy, scaler.pkl, manifest.json are
# the deployed inference artifacts and are committed deliberately -- see
# docs/IMPROVEMENT_PLAN.md Phase 4.

# Streamlit cache and secrets
.streamlit/cache/
.streamlit/secrets.toml

# Evaluation reports -- one committed per landed phase (baseline.json,
# phase1.json, ...) so each can be diffed against the last; see
# docs/IMPROVEMENT_PLAN.md. Ad-hoc/exploratory runs stay gitignored.
reports/*.json
!reports/baseline.json
!reports/phase1.json
!reports/phase3.json
!reports/phase4.json

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.swp
*.swo

# Jupyter Notebook temporary files
.jupyter/
