# Loaded by `vite build`. These are public values, not secrets: the API URL is a
# public endpoint and the Spotify client ID is a public identifier (the PKCE flow
# exists precisely so no client secret is needed).
#
# On Render, the Blueprint (render.yaml) injects VITE_API_BASE_URL from the API
# service, which overrides this file. This value is the fallback for a local
# `npm run build` and should track the real API URL. A bare host is fine —
# api.ts upgrades it to https.
VITE_API_BASE_URL=https://harmoniq-s6dl.onrender.com
VITE_SPOTIFY_CLIENT_ID=3631ec109e1f47a3899f50e4a2fcef58
