# Loaded by `vite build`. These are public values, not secrets: the API URL is a
# public endpoint and the Spotify client ID is a public identifier (the PKCE flow
# exists precisely so no client secret is needed).
#
# Committing them keeps a production build self-contained. Previously these were
# set only as Vercel dashboard variables, and when VITE_API_BASE_URL was missing
# from the Production environment the build silently fell back to
# http://localhost:8000 -- shipping a frontend that called every visitor's own
# machine. A dashboard variable of the same name still overrides this file.
VITE_API_BASE_URL=https://harmoniq-s6dl.onrender.com
VITE_SPOTIFY_CLIENT_ID=3631ec109e1f47a3899f50e4a2fcef58
