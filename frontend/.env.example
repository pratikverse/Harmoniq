# Copy to .env.development (local) or .env.production (local builds).
# On Render, render.yaml injects VITE_API_BASE_URL from the API service.
# Both values are public — no secrets here (Spotify uses PKCE, no client secret).
VITE_API_BASE_URL=https://your-render-api.onrender.com
VITE_SPOTIFY_CLIENT_ID=your-spotify-app-client-id
